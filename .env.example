# ============================================================
# 汕大 SSO / CAS 联调工具环境变量配置示例 (.env.example)
# 使用说明：复制此文件为 .env，并按实际情况填写配置
# ============================================================

# 服务监听地址与端口
HOST=127.0.0.1
PORT=3000

# 向学校网络与信息中心报备登记的公网回调域名（必须为域名根地址，不可带子路径）
# 示例: https://sso-demo.example.edu.cn
# 注意: 业务实际的回调地址将自动拼接为: ${PUBLIC_BASE_URL}/callback
PUBLIC_BASE_URL=

# 汕大统一身份认证登录地址（通常固定）
CAS_LOGIN_URL=https://sso.stu.edu.cn/login

# 汕大统一身份认证验票地址（以学校网络信息中心正式提供的接口为准）
# CAS 2.0 标准端点: https://sso.stu.edu.cn/serviceValidate
# CAS 3.0 标准端点: https://sso.stu.edu.cn/p3/serviceValidate
CAS_VALIDATE_URL=https://sso.stu.edu.cn/serviceValidate

# 仅限本地回环（127.0.0.1 / localhost）自动化测试时允许使用 HTTP
# 生产环境请勿开启（保持为 0）
ALLOW_INSECURE_LOCAL_TEST=0
